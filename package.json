    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "prettier": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsmediatags": "^3.9.7",
