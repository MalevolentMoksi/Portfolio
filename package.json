{
  "name": "enzom-portfolio",
  "version": "2.0.0",
  "description": "Portfolio professionnel - Enzo Morello",
  "type": "module",
  "scripts": {
    "dev": "vite --no-open",
    "build": "vite build && npm run seo:generate",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "seo:generate": "node scripts/generate-seo-files.mjs",
    "seo:generate:public": "node scripts/generate-seo-files.mjs --outDir=public",
    "images:generate": "node scripts/generate-image-derivatives.mjs",
    "favicons:generate": "node scripts/generate-favicons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "npx wrangler deploy"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/rollup": "^0.51.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.24",
    "axe-core": "^4.11.1",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.14",
    "prettier": "^3.1.0",
    "rollup": "^4.59.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "~8.0.16",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "framer-motion": "^12.34.3",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsmediatags": "^3.9.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.5.8",
    "react-router-dom": "^6.22.3"
  },
  "keywords": [
    "portfolio",
    "student",
    "web-development"
  ],
  "author": "Enzo Morello",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "serialize-javascript": "~7.0.5",
    "lodash": ">=4.18.0",
    "@babel/core": "^7.29.6",
    "undici": "^7.28.0"
  },
  "browserslist": [
    ">0.5%",
    "last 3 versions",
    "Firefox ESR",
    "not dead"
  ]
}
