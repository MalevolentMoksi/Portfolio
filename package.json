{
  "name": "enzom-portfolio",
  "version": "2.0.0",
  "description": "Portfolio professionnel - Enzo Morello",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run format && npm run seo:generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "seo:generate": "node scripts/generate-seo-files.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
