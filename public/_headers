# Netlify _headers configuration file
# Deploy to Netlify: these headers optimize cache lifetimes and performance

# Hashed assets (JS, CSS, fonts) — cache forever since filename includes hash
/assets/js/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Images (30 days cache)
/assets/images/*
  Cache-Control: public, max-age=2592000

# Large background images (90 days cache)
/assets/images/backgrounds/*
  Cache-Control: public, max-age=7776000

# Music files (30 days, user may replay)
/assets/music/*
  Cache-Control: public, max-age=2592000

# HTML and manifest (short cache, validate before reuse)
/index.html
  Cache-Control: public, max-age=3600, must-revalidate

/registerSW.js
  Cache-Control: public, max-age=3600, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

# Default for everything else
/*
  Cache-Control: public, max-age=600, must-revalidate
